{
  "name": "qa-automation-portfolio",
  "version": "1.0.0",
  "description": "End-to-end UI and API test automation portfolio built with Playwright and TypeScript.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "qa",
    "e2e",
    "api-testing",
    "page-object-model"
  ],
  "author": "Juan Jose Bascope Castro",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
